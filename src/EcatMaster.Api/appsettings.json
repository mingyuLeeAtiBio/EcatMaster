{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://0.0.0.0:5000" }
    }
  },
  "Master": {
    "Mode": "Soem",
    "Interface": "enp2s0",
    "CycleTimeUs": 2000,
    "RealtimePriority": 80,
    "CpuCore": 3,
    "AxisCount": 12,
    "Axes": [
      { "Id": 1, "Name": "X", "LeadUm": 10000 },
      { "Id": 2, "Name": "Y", "LeadUm": 10000 },
      { "Id": 3, "Name": "Z", "LeadUm": 5000 }
    ],
    "VendorId": 702,
    "RemapPdo": true,
    "WriteOptionCodes": false,
    "UseDistributedClocks": false,
    "IoMapSize": 4096,
    "OfflineAfterMissedCycles": 10,
    "ReceiveTimeoutUs": 2000,
    "JitterWarmupCycles": 500,
    "Defaults": {
      "UseDriveValues": true,
      "Velocity": 10000,
      "Acceleration": 300000,
      "Deceleration": 300000,
      "AckTimeoutCycles": 500
    },
    "Units": {
      "Mode": "um",
      "DefaultLeadUm": 10000,
      "AxisLeadUm": []
    },
    "IoModules": [
      { "Slave": 13, "Name": "DI1", "InputAliases": { "0": "EStop", "1": "Door", "2": "AreaSensor", "3": "StartBtn" } },
      { "Slave": 14, "Name": "DO1", "OutputAliases": { "0": "RunLamp", "1": "AlarmLamp", "2": "InterlockLamp", "3": "Heartbeat", "4": "Clamp1", "5": "Clamp2" } }
    ],
    "Interlocks": [
      { "Name": "EStop", "Module": "DI1", "Input": "EStop", "ActiveLow": true, "Action": "QuickStop", "BlockMotion": true, "OutputModule": "DO1", "Output": "InterlockLamp", "Message": "비상정지 눌림" },
      { "Name": "Door", "Module": "DI1", "Input": "Door", "ActiveLow": true, "Action": "Halt", "BlockMotion": true, "Message": "도어 열림" },
      { "Name": "AreaSensor", "Module": "DI1", "Input": "AreaSensor", "ActiveLow": false, "Action": "Halt", "Axes": [ 1, 2 ], "BlockMotion": true, "Message": "에어리어 센서 감지" }
    ],
    "StatusOutputs": [
      { "Module": "DO1", "Output": "RunLamp", "Source": "AnyMoving" },
      { "Module": "DO1", "Output": "AlarmLamp", "Source": "AnyFault" },
      { "Module": "DO1", "Output": "Heartbeat", "Source": "Heartbeat" }
    ],
    "SimulatedIoModules": [
      { "Name": "DI1", "InputBits": 16, "OutputBits": 0 },
      { "Name": "DO1", "InputBits": 0, "OutputBits": 16 }
    ]
  },
  "Serial": {
    "Ports": [
      {
        "Name": "plc",
        "Device": "/dev/ttyUSB0",
        "BaudRate": 115200,
        "DataBits": 8,
        "Parity": "None",
        "StopBits": "One",
        "NewLine": "\r\n",
        "AutoOpen": false
      }
    ]
  }
}
