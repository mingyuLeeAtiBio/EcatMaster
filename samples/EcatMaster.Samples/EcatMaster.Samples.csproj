<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- soemshim.dll 이 x64 이므로 실기(SOEM) 모드로 돌릴 때는 x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>EcatMaster.Samples</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EcatMaster.Core\EcatMaster.Core.csproj" />
    <!-- 마스터 내부 로그(연결·PDO 매핑·인터록)를 콘솔로 보기 위해 -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.*" />
  </ItemGroup>

  <!-- 실기 모드용 SOEM 심 (없으면 시뮬레이션만 가능) -->
  <ItemGroup Condition="Exists('..\..\native\soemshim\build-win\soemshim.dll')">
    <None Include="..\..\native\soemshim\build-win\soemshim.dll" CopyToOutputDirectory="PreserveNewest" Link="soemshim.dll" />
  </ItemGroup>

</Project>
