<Window x:Class="EcatMaster.Views.IoAliasEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EcatMaster.ViewModels"
        Title="IO 별칭 편집" Width="560" Height="520" MinWidth="460" MinHeight="320"
        Background="{StaticResource WindowBrush}" FontSize="13" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" x:Name="HeaderText" FontWeight="SemiBold" FontSize="14" Margin="2,0,0,4"/>
        <TextBlock DockPanel.Dock="Top" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,0,8"
                   Text="'새 별칭' 열을 고치고 저장하면 즉시 반영되고 devices.json 에 저장됩니다. 비우면 기본 이름(IN0/OUT0)으로 돌아갑니다. 인터록·상태출력 규칙이 그 별칭을 쓰고 있다면 규칙의 Input/Output 도 맞춰 주세요."/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <TextBlock x:Name="ChangedText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,0,12,0"/>
            <Button Content="저장" Style="{StaticResource PrimaryButton}" Click="Save_Click" IsDefault="True"/>
            <Button Content="취소" IsCancel="True"/>
        </StackPanel>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" RowHeight="26" SelectionUnit="Cell" SelectionMode="Single"
                  FontFamily="{StaticResource AppFont}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="모듈" Binding="{Binding ModuleName}" IsReadOnly="True" Width="80"/>
                <DataGridTextColumn Header="방향" Binding="{Binding Direction}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="비트" Binding="{Binding Index}" IsReadOnly="True" Width="44"/>
                <DataGridTextColumn Header="현재 별칭" Binding="{Binding CurrentName}" IsReadOnly="True" Width="130"/>
                <DataGridTextColumn Header="새 별칭 (더블클릭/F2 로 편집)" Binding="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Width="*">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Changed}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CautionSoftBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
