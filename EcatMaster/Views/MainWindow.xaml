<Window x:Class="EcatMaster.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EcatMaster.ViewModels"
        xmlns:infra="clr-namespace:EcatMaster.Infrastructure"
        xmlns:bh="clr-namespace:EcatMaster.Infrastructure.Behaviors"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding ConnectionText, StringFormat=EcatMaster · {0}, FallbackValue=EcatMaster}" Height="780" Width="1340"
        WindowStartupLocation="CenterScreen"
        MinHeight="700" MinWidth="1100"
        FontSize="13" FontFamily="{StaticResource AppFont}" Background="{StaticResource WindowBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        bh:WindowBehaviors.LoadedCommand="{Binding AutoConnectCommand}">


    <DockPanel>

        <!-- ================= 상단: 연결 설정 ================= -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="8,6" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <!-- 창이 좁으면 다음 줄로 넘어가도록 WrapPanel -->
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="모드" Style="{StaticResource FieldLabel}"/>
                <!-- 두 라디오를 UseSimulation 하나에 묶어 표시/상태 어긋남을 방지 -->
                <RadioButton Content="SOEM (실제)" GroupName="Mode" IsChecked="{Binding UseSimulation, Converter={StaticResource Inverse}}"
                             IsEnabled="{Binding NativeAvailable}" VerticalAlignment="Center" Margin="2,0,8,0"/>
                <RadioButton Content="시뮬레이션" GroupName="Mode" IsChecked="{Binding UseSimulation}" VerticalAlignment="Center" Margin="2,0,12,0"/>

                <TextBlock Text="NIC" Style="{StaticResource FieldLabel}"/>
                <ComboBox Width="180" Margin="2" ItemsSource="{Binding Adapters}" SelectedItem="{Binding SelectedAdapter}"
                          IsEnabled="{Binding CanEditSettings}" ToolTip="Npcap 이 인식한 어댑터 (\Device\NPF_{GUID})"/>
                <Button Content="↻" Width="30" MinWidth="30" Command="{Binding RefreshAdaptersCommand}" ToolTip="NIC 목록 새로 고침"/>

                <TextBlock Text="주기(us)" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="66" Text="{Binding CycleTimeUs}" IsEnabled="{Binding CanEditSettings}"/>
                <TextBlock Text="축 수" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="44" Text="{Binding AxisCount}" IsEnabled="{Binding CanEditSettings}"/>
                <TextBlock Text="코어" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="44" Text="{Binding CpuCore}" IsEnabled="{Binding CanEditSettings}" ToolTip="실시간 스레드 고정 코어 (-1 = 안 함)"/>
                <TextBlock Text="DC(us)" Style="{StaticResource FieldLabel}"/>
                <TextBox Width="52" Text="{Binding DcSyncOffsetUs}" IsEnabled="{Binding CanEditSettings}"
                         ToolTip="DC 동기 드라이브(VPH-HD)용 마스터 위상 오프셋 [µs]. 동기 오류가 나면 키움 (Windows 권장 500, 사이클의 1/4)"/>
                <CheckBox Content="PDO 재매핑" IsChecked="{Binding RemapPdo}" IsEnabled="{Binding CanEditSettings}" VerticalAlignment="Center" Margin="8,0"
                          ToolTip="PreOp 에서 1600h/1A00h 를 AzdPdoMap 대로 다시 씀"/>
                <CheckBox Content="자동 연결" IsChecked="{Binding AutoConnect}" IsEnabled="{Binding NativeAvailable}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="프로그램을 열면 NIC 들을 탐색해 EtherCAT 슬레이브가 있는 포트에 자동 연결. 여러 포트에 있으면 선택 창"/>

                <Button Content="연결" Style="{StaticResource PrimaryButton}" Command="{Binding ConnectCommand}" Margin="12,2,2,2"/>
                <Button Content="해제" Command="{Binding DisconnectCommand}"/>
            </WrapPanel>
        </Border>

        <!-- ================= 하단: 마스터 상태 ================= -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="8,4" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="마스터" Style="{StaticResource StatLabel}"/>
                <TextBlock Style="{StaticResource StatValue}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0} / {1}">
                            <Binding Path="Master.Mode" FallbackValue="-"/>
                            <Binding Path="Master.Running" FallbackValue="-"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="OP" Style="{StaticResource StatLabel}"/>
                <TextBlock Text="{Binding Master.AllOperational, FallbackValue=-}" Style="{StaticResource StatValue}"/>
                <TextBlock Text="슬레이브" Style="{StaticResource StatLabel}"/>
                <TextBlock Text="{Binding Master.SlaveCount, FallbackValue=-}" Style="{StaticResource StatValue}"/>
                <TextBlock Text="WKC" Style="{StaticResource StatLabel}"/>
                <TextBlock Style="{StaticResource StatValue}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0}/{1}">
                            <Binding Path="Master.LastWkc" FallbackValue="-"/>
                            <Binding Path="Master.ExpectedWkc" FallbackValue="-"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="사이클" Style="{StaticResource StatLabel}"/>
                <!-- 실시간 루프 생존 LED: 최근 5주기 안에 사이클이 돌았으면 녹색 -->
                <Ellipse Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center" Stroke="#888" StrokeThickness="0.5">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Fill" Value="#BDBDBD"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Master.CycleAlive}" Value="True">
                                    <Setter Property="Fill" Value="#43A047"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Master.CycleAlive}" Value="False">
                                    <Setter Property="Fill" Value="#E53935"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                    <Ellipse.ToolTip>
                        <TextBlock>
                            <Run Text="누적 사이클: "/><Run Text="{Binding Master.CycleCount, Mode=OneWay}"/>
                            <LineBreak/><Run Text="녹색 = 실시간 루프 실행 중, 빨강 = 정지(마지막 사이클 후 5주기 초과)"/>
                        </TextBlock>
                    </Ellipse.ToolTip>
                </Ellipse>
                <TextBlock Style="{StaticResource StatValue}" ToolTip="최근 1초 실측 사이클 수/초와 평균 주기. 설정 주기(2 ms → 500/s)와 비교">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{}{0:F0}/s ({1:F2} ms)">
                            <Binding Path="Master.CyclesPerSecond" FallbackValue="0"/>
                            <Binding Path="Master.ActualCycleTimeUs" Converter="{StaticResource UsToMs}" FallbackValue="0"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="놓친 사이클" Style="{StaticResource StatLabel}"/>
                <TextBlock Text="{Binding Master.MissedCycles, FallbackValue=-}" Style="{StaticResource StatValue}"/>
                <TextBlock Text="WKC 오류" Style="{StaticResource StatLabel}"/>
                <TextBlock Text="{Binding Master.WkcErrors, FallbackValue=-}" Style="{StaticResource StatValue}"/>
                <TextBlock Text="최대 지터(us)" Style="{StaticResource StatLabel}"/>
                <TextBlock Text="{Binding Master.MaxJitterUs, StringFormat={}{0:F1}, FallbackValue=-}" Style="{StaticResource StatValue}"/>
                <Button Content="통계 리셋" Command="{Binding ResetStatsCommand}" Height="22" MinWidth="64" Padding="6,0" Margin="12,0,0,0" FontSize="11"
                        ToolTip="최대 지터, 놓친 사이클, WKC 오류 누적값 초기화"/>
                <TextBlock Text="IO" Style="{StaticResource StatLabel}"/>
                <TextBlock Text="{Binding Master.IoModuleCount, FallbackValue=-}" Style="{StaticResource StatValue}"/>
                <TextBlock Text="{Binding InterlockSummary}" Foreground="{StaticResource ErrBrush}" Margin="16,0,0,0" FontWeight="Bold"/>
                <TextBlock Text="{Binding Master.LastError}" Foreground="{StaticResource ErrBrush}" Margin="16,0,0,0" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- ================= 본문 ================= -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="150"/>
            </Grid.RowDefinitions>

            <!-- 좌: 축 / 슬레이브 -->
            <Grid Grid.Column="0" Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="5*"/>
                    <RowDefinition Height="3*"/>
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run Text="축 (선택하면 우측에서 제어)  ·  위치/속도/목표 단위: "/>
                            <Run Text="{Binding PosUnitLabel, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding VelUnitLabel, Mode=OneWay}" FontWeight="Bold"/>
                        </TextBlock>
                    </GroupBox.Header>
                    <DataGrid ItemsSource="{Binding Axes}" SelectedItem="{Binding SelectedAxis}" AutoGenerateColumns="False"
                              IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal" FontFamily="{StaticResource MonoFont}" RowHeight="24">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Fault}" Value="True">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Online}" Value="False">
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="34"/>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="70"/>
                            <DataGridTextColumn Header="드라이브" Binding="{Binding Profile}" Width="64"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource OkBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Fault}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource ErrBrush}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="모드" Binding="{Binding Mode}" Width="120"/>
                            <DataGridTextColumn Header="동작" Binding="{Binding Activity}" Width="70"/>
                            <DataGridTextColumn Header="위치" Binding="{Binding PositionText}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="속도" Binding="{Binding VelocityText}" Width="85">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="RPM" Binding="{Binding RpmText}" Width="70">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/><Setter Property="ToolTip" Value="실속도를 출력축 회전수로 환산 (분해능·기어비 반영)"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="목표" Binding="{Binding TargetText}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextAlignment" Value="Right"/></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridCheckBoxColumn Header="도달" Binding="{Binding TargetReached, Mode=OneWay}" Width="44"/>
                            <DataGridTextColumn Header="SW" Binding="{Binding StatusWordHex}" Width="64"/>
                            <DataGridTextColumn Header="CW" Binding="{Binding ControlWordHex}" Width="64"/>
                            <DataGridTextColumn Header="에러" Binding="{Binding ErrorCodeHex}" Width="64"/>
                            <DataGridTextColumn Header="인터록" Binding="{Binding BlockReason}" Width="110">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource ErrBrush}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="마지막 오류" Binding="{Binding LastError}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>

                <TabControl Grid.Row="1" Margin="4">
                <TabItem Header="슬레이브">
                    <DataGrid ItemsSource="{Binding Slaves}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontFamily="{StaticResource MonoFont}" RowHeight="22">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="34"/>
                            <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="Vendor" Binding="{Binding VendorId, StringFormat=0x{0:X}}" Width="80"/>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductCode, StringFormat=0x{0:X}}" Width="90"/>
                            <DataGridTextColumn Header="상태" Binding="{Binding State}" Width="80"/>
                            <DataGridTextColumn Header="Out" Binding="{Binding OutputBytes}" Width="44"/>
                            <DataGridTextColumn Header="In" Binding="{Binding InputBytes}" Width="44"/>
                            <DataGridTextColumn Header="AL" Binding="{Binding AlStatus, StringFormat=0x{0:X4}}" Width="70"/>
                            <DataGridTextColumn Header="AL 설명" Binding="{Binding AlStatusText}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>

                <TabItem Header="IO">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Margin="8,6,8,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="스테이션별 탭(입력·출력 모듈 한 쌍, 또는 단독 모듈). 출력 비트는 클릭해 토글, 입력은 시뮬레이션 모드에서만 클릭해 강제(주황 테두리 = 강제 중). 오른쪽 클릭 → 별칭 변경(devices.json 저장). '창으로 열기'는 모듈을 별도 창(모달리스)으로 띄워 다른 탭을 보면서도 감시할 수 있다."/>
                        <TextBlock DockPanel.Dock="Top" Margin="8,10" Foreground="{StaticResource MutedBrush}" Text="IO 모듈이 없습니다.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IoModules.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- IO 모듈마다 TabItem 하나 (ItemsSource 바인딩) -->
                        <TabControl x:Name="IoTabs" ItemsSource="{Binding IoGroups}" ItemTemplate="{StaticResource IoGroupTabHeaderTemplate}" Margin="4" BorderThickness="0">
                            <TabControl.ItemContainerStyle>
                                <!-- 헤더가 템플릿이라 UIA 이름이 비므로 모듈 이름을 접근성 이름으로 -->
                                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
                                </Style>
                            </TabControl.ItemContainerStyle>
                            <TabControl.Template>
                                <!-- 바깥 TabControl 카드 안에 들어가므로 테두리 없이 -->
                                <ControlTemplate TargetType="TabControl">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="2,0">
                                            <TabPanel IsItemsHost="True"/>
                                        </Border>
                                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                                    </DockPanel>
                                </ControlTemplate>
                            </TabControl.Template>
                            <TabControl.ContentTemplate>
                                <DataTemplate DataType="{x:Type vm:IoGroupViewModel}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="창으로 열기" Command="{Binding DataContext.OpenIoGroupWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Top" Height="26" MinWidth="90" FontSize="11" Margin="8,0,0,0"
                                                    ToolTip="이 그룹을 별도 창(모달리스)으로 띄운다"/>
                                            <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource IoGroupContentTemplate}"/>
                                        </DockPanel>
                                    </ScrollViewer>
                                </DataTemplate>
                            </TabControl.ContentTemplate>
                        </TabControl>
                    </DockPanel>
                </TabItem>

                <TabItem Header="인터록">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                            <Button Content="추가…" Command="{Binding AddInterlockCommand}" Style="{StaticResource PrimaryButton}" MinWidth="70" Height="24" FontSize="11"
                                    ToolTip="새 인터록 규칙 (디지털 입력 / 축 이동 중 / 축 위치 범위). 연결 후 편집 가능"/>
                            <Button Content="편집…" Command="{Binding EditInterlockCommand}" MinWidth="70" Height="24" FontSize="11" Margin="4,0,0,0" ToolTip="선택한 규칙 편집 (행 더블클릭도 가능)"/>
                            <Button Content="삭제" Command="{Binding DeleteInterlockCommand}" Style="{StaticResource DangerButton}" MinWidth="60" Height="24" FontSize="11" Margin="4,0,0,0" ToolTip="선택한 규칙 삭제 (확인 창)"/>
                            <Button Content="해제된 인터록 모두 켜기" Command="{Binding EnableAllInterlocksCommand}" MinWidth="140" Height="24" FontSize="11" Margin="12,0,0,0"/>
                            <Button Content="구성 파일 열기 (devices.json)" Command="{Binding OpenDeviceConfigCommand}" MinWidth="170" Height="24" FontSize="11" Margin="4,0,0,0"/>
                            <TextBlock Text="  '사용' 체크를 끄면 그 규칙은 평가되지 않습니다(시운전·점검용). 변경은 즉시 적용되고 devices.json 에 저장됩니다." VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Interlocks}" SelectedItem="{Binding SelectedInterlock}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" FontFamily="{StaticResource AppFont}" RowHeight="24" SelectionUnit="FullRow" SelectionMode="Single"
                                  HorizontalScrollBarVisibility="Auto" IsReadOnly="True"
                                  bh:DataGridBehaviors.SingleClickCheckBox="True" bh:DataGridBehaviors.DoubleClickCommand="{Binding EditInterlockRowCommand}">
                            <DataGrid.CellStyle>
                                <!-- 셀이 포커스를 가로채지 않게 해 템플릿 안 체크박스를 한 번 클릭으로 토글 -->
                                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <!-- DataGrid 가 첫 클릭을 셀 선택에 써 버려 체크박스가 두 번 클릭돼야 하는 문제 → 첫 클릭에서 바로 토글 -->
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Active}" Value="True">
                                            <Setter Property="Background" Value="#FFCDD2"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="사용" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      ToolTip="끄면 이 인터록을 평가하지 않음 (확인 창 후 적용)"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="이름" Binding="{Binding Name}" Width="100" IsReadOnly="True"/>
                                <!-- 참조 위치·조건: 어느 슬레이브/축의 무엇을 보는지 -->
                                <DataGridTextColumn Header="소스 (슬레이브/축)" Binding="{Binding SourceText}" Width="130" IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="ToolTip" Value="{Binding ConditionTooltip}"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="조건" Binding="{Binding ConditionText}" Width="220" IsReadOnly="True">
                                    <DataGridTextColumn.CellStyle>
                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                                            <Setter Property="ToolTip" Value="{Binding ConditionTooltip}"/>
                                            <Setter Property="Focusable" Value="False"/>
                                        </Style>
                                    </DataGridTextColumn.CellStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="현재값" Binding="{Binding CurrentValueText}" Width="95" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="활성" Binding="{Binding Active, Mode=OneWay}" Width="48" IsReadOnly="True"/>
                                <DataGridTextColumn Header="방식" Binding="{Binding ModeText}" Width="96" IsReadOnly="True"/>
                                <DataGridTextColumn Header="동작" Binding="{Binding Action}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="대상 축" Binding="{Binding AxesText}" Width="130" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="차단" Binding="{Binding BlockMotion, Mode=OneWay}" Width="48" IsReadOnly="True"/>
                                <DataGridTextColumn Header="표시 출력 (슬레이브)" Binding="{Binding OutputText}" Width="215" IsReadOnly="True"/>
                                <DataGridTextColumn Header="횟수" Binding="{Binding TriggerCount}" Width="48" IsReadOnly="True"/>
                                <DataGridTextColumn Header="마지막" Binding="{Binding LastTriggeredUtc, Converter={StaticResource LocalTime}}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="메시지 / 오류" Binding="{Binding MessageOrError}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </TabItem>
                </TabControl>
            </Grid>

            <!-- 우: 제어 -->
            <ScrollViewer Grid.Column="1" Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="전체 축">
                    <WrapPanel>
                        <Button Content="전체 서보 온" Style="{StaticResource PrimaryButton}" Command="{Binding EnableAllCommand}"/>
                        <Button Content="전체 서보 오프" Command="{Binding DisableAllCommand}"/>
                        <Button Content="전체 알람 리셋" Command="{Binding FaultResetAllCommand}"/>
                        <Button Content="전체 정지" Command="{Binding StopAllCommand}"/>
                        <Button Content="전체 급정지" Style="{StaticResource DangerButton}" Command="{Binding QuickStopAllCommand}"/>
                    </WrapPanel>
                </GroupBox>

                <GroupBox>
                    <GroupBox.Header>
                        <TextBlock>
                            <Run Text="선택 축: "/>
                            <Run Text="{Binding SelectedAxis.Id, Mode=OneWay, FallbackValue=-}"/>
                            <Run Text=" · "/>
                            <Run Text="{Binding SelectedAxis.Name, Mode=OneWay, FallbackValue=(없음)}" FontWeight="Bold"/>
                        </TextBlock>
                    </GroupBox.Header>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="별칭" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="120" Text="{Binding SelectedAxisAlias, UpdateSourceTrigger=PropertyChanged}" ToolTip="API 경로(/api/axes/별칭)와 화면에 쓰이는 이름. 숫자만은 피할 것"/>
                            <Button Content="별칭 저장" Command="{Binding SaveAxisAliasCommand}" MinWidth="80" ToolTip="즉시 반영 + devices.json 저장"/>
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="서보 온" Style="{StaticResource PrimaryButton}" Command="{Binding EnableCommand}"/>
                            <Button Content="서보 오프" Command="{Binding DisableCommand}"/>
                            <Button Content="알람 리셋" Command="{Binding FaultResetCommand}"/>
                        </WrapPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="단위" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Width="70" Height="26" Margin="2" ItemsSource="{Binding UnitModes}" SelectedItem="{Binding SelectedUnit}"
                                      ToolTip="um: 위치 µm, 속도 µm/s, 가감속 µm/s² / step: 드라이브 원단위"/>
                            <TextBlock Text="리드" Style="{StaticResource FieldLabel}" Margin="10,0,4,0"/>
                            <TextBox Width="80" Text="{Binding LeadUm}" IsEnabled="{Binding CanEditSettings}"
                                     ToolTip="출력축 1회전당 이동량 [µm]. 연결 시 모든 축에 적용, 축별 값은 아래 드라이브 설정에서"/>
                            <TextBlock Text="µm/rev" Style="{StaticResource FieldLabel}"/>
                        </StackPanel>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="목표 위치" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TargetPosition}" AutomationProperties.Name="목표 위치"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PosUnitLabel}" Style="{StaticResource FieldLabel}"/>

                            <TextBlock Grid.Row="1" Text="속도" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Velocity}" AutomationProperties.Name="속도" ToolTip="0 이면 드라이브에서 읽은 기본값(6081h)"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VelUnitLabel}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding VelocityRpmText}" Style="{StaticResource FieldLabel}" Foreground="{StaticResource MutedBrush}" ToolTip="출력축 회전수 환산 (분해능·기어비·리드 반영)"/>

                            <TextBlock Grid.Row="2" Text="가속" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Acceleration}" ToolTip="0 이면 드라이브 기본값(6083h)"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AccUnitLabel}" Style="{StaticResource FieldLabel}"/>

                            <TextBlock Grid.Row="3" Text="감속" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Deceleration}" ToolTip="0 이면 드라이브 기본값(6084h)"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding AccUnitLabel}" Style="{StaticResource FieldLabel}"/>

                            <TextBlock Grid.Row="4" Text="조그 속도" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding JogVelocity}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding VelUnitLabel}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding JogVelocityRpmText}" Style="{StaticResource FieldLabel}" Foreground="{StaticResource MutedBrush}" ToolTip="출력축 회전수 환산 (분해능·기어비·리드 반영)"/>
                        </Grid>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="절대 이동" Style="{StaticResource PrimaryButton}" Command="{Binding MoveAbsoluteCommand}"/>
                            <Button Content="상대 이동" Command="{Binding MoveRelativeCommand}"/>
                            <Button Content="원점 복귀" Command="{Binding HomeCommand}"/>
                        </WrapPanel>
                        <WrapPanel>
                            <!-- 누르는 동안 조그, 떼는 순간 Halt. Command 대신 코드비하인드의 마우스 이벤트로 처리 -->
                            <Button Content="◀ 조그 -" IsEnabled="{Binding CanControlAxis}" MinWidth="90" bh:Jog.StartCommand="{Binding JogMinusCommand}"
                                    bh:Jog.StopCommand="{Binding StopCommand}"
                                    ToolTip="누르는 동안 - 방향 조그, 떼면 정지"/>
                            <Button Content="조그 + ▶" IsEnabled="{Binding CanControlAxis}" MinWidth="90" bh:Jog.StartCommand="{Binding JogPlusCommand}"
                                    bh:Jog.StopCommand="{Binding StopCommand}"
                                    ToolTip="누르는 동안 + 방향 조그, 떼면 정지"/>
                        </WrapPanel>
                        <WrapPanel>
                            <Button Content="정지 (Halt)" Command="{Binding StopCommand}" MinWidth="110"/>
                            <Button Content="급정지 (Quick Stop)" Style="{StaticResource DangerButton}" Command="{Binding QuickStopCommand}" MinWidth="140"/>
                        </WrapPanel>

                        <Border Background="{StaticResource PanelBrush}" Padding="6" Margin="0,10,0,0" CornerRadius="3">
                            <StackPanel>
                                <TextBlock Text="상태 워드 비트" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock Text="{Binding SelectedAxis.StatusBits}" TextWrapping="Wrap" FontFamily="{StaticResource MonoFont}" Margin="0,2,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="DI" Foreground="{StaticResource MutedBrush}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding SelectedAxis.DigitalInputsHex}" FontFamily="{StaticResource MonoFont}"/>
                                    <TextBlock Text="오류" Foreground="{StaticResource MutedBrush}" Margin="16,0,6,0"/>
                                    <TextBlock Text="{Binding SelectedAxis.ErrorCodeHex}" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource ErrBrush}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SelectedAxis.LastError}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="왕복 테스트 (A ↔ B, 지정 속도로 N회 · 검증용)">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="A 지점" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CtPointA}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PosUnitLabel}" Style="{StaticResource FieldLabel}"/>
                            <Button Grid.Row="0" Grid.Column="3" Content="현재→A" Command="{Binding CtSetAFromCurrentCommand}" MinWidth="64" Height="24" FontSize="11" ToolTip="현재 위치를 A 로"/>

                            <TextBlock Grid.Row="1" Text="B 지점" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CtPointB}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PosUnitLabel}" Style="{StaticResource FieldLabel}"/>
                            <Button Grid.Row="1" Grid.Column="3" Content="현재→B" Command="{Binding CtSetBFromCurrentCommand}" MinWidth="64" Height="24" FontSize="11" ToolTip="현재 위치를 B 로"/>

                            <TextBlock Grid.Row="2" Text="속도" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CtVelocity}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding VelUnitLabel}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding CtVelocityRpmText}" Style="{StaticResource FieldLabel}" Foreground="{StaticResource MutedBrush}" ToolTip="출력축 회전수 환산 (분해능·기어비·리드 반영)"/>

                            <TextBlock Grid.Row="3" Text="왕복 횟수" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CtCycles}" ToolTip="0 = 중지할 때까지 무한"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="회" Style="{StaticResource FieldLabel}"/>

                            <TextBlock Grid.Row="4" Text="정지 시간" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CtDwellMs}" ToolTip="각 지점 도달 후 대기"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="ms" Style="{StaticResource FieldLabel}"/>
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="▶ 왕복 시작" Style="{StaticResource PrimaryButton}" Command="{Binding CtStartCommand}" MinWidth="100"
                                    ToolTip="서보 온 상태에서 시작. 가감속은 위의 가속/감속 입력값 사용"/>
                            <Button Content="■ 중지" Style="{StaticResource DangerButton}" Command="{Binding CtStopCommand}" MinWidth="80"
                                    ToolTip="진행 중 이동은 감속 정지(Halt)"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding CtStatusText}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="4,6,0,0"/>
                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="4,4,0,0"
                                   Text="서보 오프·알람·인터록·위치 오차(허용 5 step)·이동 타임아웃(60 s)이면 자동 중단되고 사유가 표시됩니다. 축을 바꾸면 그 축의 테스트 상태를 보여 줍니다."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="연속 운전 (시간 기반 내구 시험 · 에러 기록)">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="방식" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Height="26" Margin="2" ItemsSource="{Binding EtModes}" SelectedItem="{Binding EtMode}" IsEnabled="{Binding EtRunning, Converter={StaticResource Inverse}}"
                                      ToolTip="연속 회전: 속도 모드로 한 방향 계속 회전 / 왕복: 위 왕복 테스트의 A·B 지점과 정지 시간을 사용"/>
                            <CheckBox Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Content="역방향" IsChecked="{Binding EtReverse}" VerticalAlignment="Center" Margin="6,0,0,0"
                                      Visibility="{Binding EtIsRotate, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding EtRunning, Converter={StaticResource Inverse}}"/>

                            <TextBlock Grid.Row="1" Text="속도" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding EtVelocity}" AutomationProperties.Name="연속 운전 속도" IsEnabled="{Binding EtRunning, Converter={StaticResource Inverse}}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VelUnitLabel}" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding EtVelocityRpmText}" Style="{StaticResource FieldLabel}" Foreground="{StaticResource MutedBrush}" ToolTip="출력축 회전수 환산 (분해능·기어비·리드 반영)"/>

                            <TextBlock Grid.Row="2" Text="운전 시간" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding EtDuration}" AutomationProperties.Name="연속 운전 시간" IsEnabled="{Binding EtCanEditDuration}"/>
                            <ComboBox Grid.Row="2" Grid.Column="2" Height="26" Margin="2" ItemsSource="{Binding EtDurationUnits}" SelectedItem="{Binding EtDurationUnit}" IsEnabled="{Binding EtCanEditDuration}"/>
                            <CheckBox Grid.Row="2" Grid.Column="3" Content="무한" IsChecked="{Binding EtInfinite}" VerticalAlignment="Center" Margin="6,0,0,0"
                                      IsEnabled="{Binding EtRunning, Converter={StaticResource Inverse}}" AutomationProperties.Name="연속 운전 무한"
                                      ToolTip="중지 버튼을 누르거나 오류로 끝날 때까지 계속 운전 (자동 복구를 켜면 횟수 소진 전까지 이어감)"/>

                            <TextBlock Grid.Row="3" Text="기록 주기" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding EtSampleSeconds}" IsEnabled="{Binding EtRunning, Converter={StaticResource Inverse}}" ToolTip="샘플 CSV(위치·속도·RPM·상태·WKC·지터) 기록 간격"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="s" Style="{StaticResource FieldLabel}"/>

                            <TextBlock Grid.Row="4" Text="속도 허용 편차" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding EtSpeedTolerance}" IsEnabled="{Binding EtRunning, Converter={StaticResource Inverse}}" ToolTip="연속 회전에서 실속도가 지령보다 이 비율 이상 1초 넘게 벗어나면 경고로 기록. 0 = 검사 안 함"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="%" Style="{StaticResource FieldLabel}"/>

                            <CheckBox Grid.Row="5" Grid.Column="1" Content="오류 시 자동 복구 (알람 리셋 → 서보 온 → 재개)" IsChecked="{Binding EtAutoRecover}" VerticalAlignment="Center" Margin="2,4"
                                      IsEnabled="{Binding EtRunning, Converter={StaticResource Inverse}}" ToolTip="끄면 첫 오류에서 감속 정지하고 시험을 끝낸다"/>
                            <StackPanel Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Visibility="{Binding EtAutoRecover, Converter={StaticResource BoolToVis}}">
                                <TextBox Width="40" Text="{Binding EtMaxRecoveries}" IsEnabled="{Binding EtRunning, Converter={StaticResource Inverse}}" ToolTip="최대 자동 복구 횟수"/>
                                <TextBlock Text="회까지" Style="{StaticResource FieldLabel}"/>
                            </StackPanel>
                        </Grid>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="▶ 연속 운전 시작" Style="{StaticResource PrimaryButton}" Command="{Binding EtStartCommand}" MinWidth="120"
                                    ToolTip="서보 온 상태에서 시작. 가감속은 축 제어의 가속/감속 입력값 사용"/>
                            <Button Content="■ 중지" Style="{StaticResource DangerButton}" Command="{Binding EtStopCommand}" MinWidth="80" ToolTip="감속 정지(Halt) 후 요약 기록"/>
                            <Button Content="기록 폴더" Command="{Binding EtOpenFolderCommand}" MinWidth="80" ToolTip="사건(_events.csv)·샘플(_samples.csv)·요약(_summary.txt) 파일 위치"/>
                        </WrapPanel>
                        <ProgressBar Height="6" Margin="4,6,4,0" Minimum="0" Maximum="100" Value="{Binding EtProgress, Mode=OneWay}"/>
                        <TextBlock Text="{Binding EtStatusText}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="4,6,0,0"/>
                        <ListBox ItemsSource="{Binding EtEvents}" Height="120" Margin="0,6,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                 AutomationProperties.Name="연속 운전 사건"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="드라이브 설정 (연결 시 드라이브에서 읽음 · 수정 후 쓰기)">
                    <StackPanel>
                        <TextBlock Text="{Binding DsSource}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding DsGearALabel}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" FontSize="11"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DsGearA}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="6091h:01" Style="{StaticResource FieldLabel}" FontSize="11"/>

                            <TextBlock Grid.Row="1" Text="{Binding DsGearBLabel}" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" FontSize="11"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding DsGearB}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="6091h:02" Style="{StaticResource FieldLabel}" FontSize="11"/>

                            <TextBlock Grid.Row="2" Text="기어비 (×0.01)" Style="{StaticResource FieldLabel}" Visibility="{Binding DsShowGearRatio, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DsGearRatioRaw}" ToolTip="0 = 비활성(1.0), 720 = 7.2" Visibility="{Binding DsShowGearRatio, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="47F1h" Style="{StaticResource FieldLabel}" FontSize="11" Visibility="{Binding DsShowGearRatio, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="3" Text="엔코더 분해능 (pulse/rev)" Style="{StaticResource FieldLabel}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding DsShowPulses, Converter={StaticResource BoolToVis}}"/>
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DsPulsesPerRev}" ToolTip="모터 사양의 엔코더 분해능 (20 bit = 1048576, 23 bit = 8388608). 지령단위/rev = 분해능 × 분모 / 분자" Visibility="{Binding DsShowPulses, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="SW" Style="{StaticResource FieldLabel}" FontSize="11" Visibility="{Binding DsShowPulses, Converter={StaticResource BoolToVis}}"/>

                            <TextBlock Grid.Row="4" Text="리드 (µm/rev)" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DsLeadUm}"/>
                            <TextBlock Grid.Row="4" Grid.Column="2" Text="SW" Style="{StaticResource FieldLabel}" FontSize="11" ToolTip="드라이브에 없는 값 (소프트웨어 설정)"/>

                            <TextBlock Grid.Row="5" Style="{StaticResource FieldLabel}" FontSize="11">
                                <Run Text="기본 속도 ("/><Run Text="{Binding DsVelUnit, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                            <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DsVelocity}"/>
                            <TextBlock Grid.Row="5" Grid.Column="2" Text="6081h" Style="{StaticResource FieldLabel}" FontSize="11"/>

                            <TextBlock Grid.Row="6" Style="{StaticResource FieldLabel}" FontSize="11">
                                <Run Text="기본 가속 ("/><Run Text="{Binding DsAccUnit, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                            <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding DsAcceleration}"/>
                            <TextBlock Grid.Row="6" Grid.Column="2" Text="6083h" Style="{StaticResource FieldLabel}" FontSize="11"/>

                            <TextBlock Grid.Row="7" Style="{StaticResource FieldLabel}" FontSize="11">
                                <Run Text="기본 감속 ("/><Run Text="{Binding DsAccUnit, Mode=OneWay}"/><Run Text=")"/>
                            </TextBlock>
                            <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding DsDeceleration}"/>
                            <TextBlock Grid.Row="7" Grid.Column="2" Text="6084h" Style="{StaticResource FieldLabel}" FontSize="11"/>
                        </Grid>
                        <TextBlock Text="{Binding DsFormula}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,6,0,0"/>
                        <TextBlock Text="{Binding DsResolutionText}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="4,2,0,0"/>
                        <TextBlock Text="{Binding DsVelocityRpmText}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Margin="4,2,0,0"/>
                        <WrapPanel Margin="0,6,0,0">
                            <Button Content="드라이브에서 읽기" Command="{Binding ReadDriveSettingsCommand}" MinWidth="120"/>
                            <Button Content="쓰기 (RAM)" Command="{Binding WriteDriveSettingsCommand}" MinWidth="90"
                                    ToolTip="변경된 항목만 SDO 로 기록. 전자기어는 Configuration/재기동 후 반영"/>
                            <Button Content="Configuration" Command="{Binding RunConfigurationCommand}" MinWidth="100" IsEnabled="{Binding DsMaintenanceEnabled}"
                                    ToolTip="AZ 전용: 쓰기 후 40C6h 실행 → 전자기어/기어비 즉시 재계산. 서보 오프 상태에서"/>
                            <Button Content="NV 저장" Command="{Binding SaveNvmCommand}" Style="{StaticResource DangerButton}" MinWidth="80" IsEnabled="{Binding DsMaintenanceEnabled}"
                                    ToolTip="AZ 전용: 쓰기 후 40C9h 실행 → 비휘발성 메모리 저장 (약 10만 회 제한, 5초간 전원 유지)"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding DsMessage}" FontFamily="{StaticResource MonoFont}" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" Margin="4,6,0,0"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="SDO 읽기/쓰기 (드라이브 파라미터 확인용, SOEM 모드)">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="52"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="슬레이브" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="1" Text="{Binding SdoSlave}"/>
                            <TextBlock Grid.Column="2" Text="인덱스" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="3" Text="{Binding SdoIndexHex}" ToolTip="16진수, 예: 6061 / 6091 / 1600"/>
                            <TextBlock Grid.Column="4" Text="서브" Style="{StaticResource FieldLabel}"/>
                            <TextBox Grid.Column="5" Text="{Binding SdoSubIndex}"/>
                            <TextBlock Grid.Column="6" Text="크기" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Column="7" Height="26" Margin="2" ItemsSource="{Binding SdoSizes}" SelectedItem="{Binding SdoSize}"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="값" Style="{StaticResource FieldLabel}"/>
                            <TextBox Width="120" Text="{Binding SdoValueText}" ToolTip="10진수 또는 0x 접두 16진수"/>
                            <Button Content="읽기" Command="{Binding SdoReadCommand}"/>
                            <Button Content="쓰기" Command="{Binding SdoWriteCommand}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding SdoResultText}" FontFamily="{StaticResource MonoFont}" TextWrapping="Wrap" Margin="4,6,0,0"/>
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="4,6,0,0"
                                   Text="자주 쓰는 것: 6061h 동작모드 표시(1B) · 6091h:01/02 기어비(4B) · 6098h 원점방식(1B) · 6099h:01/02 원점속도(4B) · 607Dh:01/02 소프트리밋(4B) · 603Fh 에러코드(2B)"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            </ScrollViewer>

            <!-- 하단: 로그 -->
            <GroupBox Grid.Row="1" Grid.ColumnSpan="2">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="로그" VerticalAlignment="Center"/>
                        <Button Content="지우기" Command="{Binding ClearLogCommand}" Height="20" MinWidth="50" Padding="6,0" Margin="12,0,0,0" FontSize="11"/>
                    </StackPanel>
                </GroupBox.Header>
                <ListBox ItemsSource="{Binding Log}" bh:ListBoxBehaviors.AutoScrollToEnd="True" FontFamily="{StaticResource MonoFont}" FontSize="12"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
